{
  "expo": {
    "name": "RotaFit",
    "slug": "rotafit",
    "version": "1.0.0",
    "scheme": "rotafit",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seuusuario.rotafit"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.seuusuario.rotafit",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O RotaFit precisa da sua localização para registrar o trajeto da corrida.",
          "locationWhenInUsePermission": "O RotaFit precisa da sua localização para registrar o trajeto da corrida."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
